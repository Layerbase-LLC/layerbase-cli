{
  "name": "layerbase",
  "version": "1.2.1",
  "description": "Layerbase cloud CLI: connect to your managed databases without leaking the connection string into shell history.",
  "type": "module",
  "bin": {
    "layerbase": "dist/cli.js",
    "lbase": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "start": "node dist/cli.js",
    "build": "pnpm clean && pnpm build:tsc && pnpm build:alias && pnpm build:shebang",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:tsc": "tsc -p tsconfig.build.json",
    "build:alias": "tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "build:shebang": "node scripts/shebang.mjs",
    "format": "prettier --write .",
    "lint": "eslint .",
    "check:types": "tsc --noEmit",
    "check:collisions": "tsx scripts/check-spindb-collisions.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc --noEmit && eslint . && pnpm check:collisions",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "ink": "^7.1.0",
    "ink-spinner": "^5.0.0",
    "meow": "^14.1.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "keywords": [
    "layerbase",
    "database",
    "cli",
    "postgres",
    "mysql",
    "mariadb",
    "redis",
    "valkey",
    "cloud"
  ],
  "author": "Bob Bass",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Layerbase-LLC/layerbase-cli.git"
  },
  "homepage": "https://layerbase.com",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.23.0"
}
