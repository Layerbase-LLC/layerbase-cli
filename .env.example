# Override the web API base used by the browser-login flow (default
# https://layerbase.com).
# LAYERBASE_API_URL=https://layerbase.com

# Personal sk_ API key for headless cloud access (CI, agents). When set, cloud
# commands run with NO browser and NO login step: calls go straight to the cloud
# API. `layerbase login --api-key <key>` persists it instead of using the env
# var. Create one at https://layerbase.com/cloud/settings.
# LAYERBASE_API_KEY=

# Override the cloud API base used in key mode (default
# https://cloud.layerbase.dev).
# LAYERBASE_CLOUD_API_URL=https://cloud.layerbase.dev
